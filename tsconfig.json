{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["runtime/**/*.mjs", "scripts/**/*.mjs", "examples/document-qa/**/*.mjs"],
  "exclude": ["dist", "node_modules"]
}
