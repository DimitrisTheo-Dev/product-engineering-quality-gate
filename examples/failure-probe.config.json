{
  "tools": ["oxfmt", "oxlint", "typescript"],
  "checks": [
    {
      "name": "Oxfmt",
      "kind": "format",
      "script": "format:check",
      "concurrent": true
    },
    {
      "name": "Oxlint",
      "kind": "lint",
      "script": "lint",
      "concurrent": true
    },
    {
      "name": "Typecheck",
      "kind": "typecheck",
      "script": "intentionally-missing-quality-gate-probe",
      "concurrent": true
    },
    {
      "name": "Tests",
      "kind": "test",
      "script": "test"
    },
    {
      "name": "Build",
      "kind": "build",
      "script": "build"
    },
    {
      "name": "Product behavior",
      "kind": "product",
      "script": "test:product"
    }
  ]
}
