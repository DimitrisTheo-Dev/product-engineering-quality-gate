{
  "name": "product-engineering-quality-gate",
  "version": "1.0.0",
  "private": true,
  "description": "A small, reusable GitHub Actions quality gate with safe repository onboarding.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build-workflow.mjs --check",
    "generate": "node scripts/build-workflow.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:product": "node --test examples/document-qa/*.test.mjs",
    "test:adoption": "node scripts/verify-adoption.mjs",
    "onboard": "node scripts/onboard.mjs",
    "gate": "node runtime/gate.mjs",
    "test:smoke": "playwright test --config examples/browser-smoke/playwright.config.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "test:smoke:failure": "QG_SMOKE_FORCE_FAILURE=1 playwright test --config examples/browser-smoke/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
